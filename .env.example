# Database Configuration
POSTGRES_USER=boxuser
POSTGRES_PASSWORD=boxpass
POSTGRES_DB=boxcopilot
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PORT=6379
# Required: password for Redis (requirepass) and the backend session store. Generate e.g. with: openssl rand -base64 24
REDIS_PASSWORD=

# Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# OAuth2/OIDC Configuration (Nextcloud)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
NEXTCLOUD_URL=https://example.nextcloud.com
NEXTCLOUD_LOGOUT_URL=https://example.nextcloud.com/index.php/logout

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8080

# Image Storage Path
# Development: ./data/images (relative path)
# Production: /var/boxcopilot/images (absolute path)
# Windows: C:/boxcopilot/images (use forward slashes)
APP_IMAGE_STORAGE_PATH=/var/boxcopilot/images

# Admin User Configuration
ADMIN_USERNAME=admin
# Required in production: no default; startup fails if empty or "admin". Generate e.g. with: openssl rand -base64 24
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Magic Login Link Configuration
MAGIC_LINK_VALID_HOURS=24

# Traefik Hostnames
TRAEFIK_FRONTEND_HOST=box.localhost
TRAEFIK_BACKEND_HOST=box-backend.localhost

# Trusted reverse proxy addresses (Java regular expression, NOT CIDR notation).
# Tomcat's RemoteIpValve matches the immediate peer address against this pattern before trusting its
# X-Forwarded-* headers. Needed for correct client IPs in MCP rate limiting and the MCP audit log.
# Default (see application-prod.yml) covers RFC1918 private ranges plus loopback; narrow it to the
# actual Traefik/proxy address space in production.
TRUSTED_PROXY_PATTERN=

# Claude / MCP integration (see docs/ops/mcp-server.md for the operations guide)
# Master kill-switch; false = feature fully disabled, no MCP endpoints reachable.
APP_MCP_ENABLED=false
# Public base URL of this backend (OAuth issuer / resource identifier). Required when APP_MCP_ENABLED=true;
# must be https in production.
BACKEND_URL=https://box-backend.example.com
# Cron schedule for the nightly cleanup of expired/invalidated MCP authorizations.
APP_MCP_CLEANUP_CRON=0 0 3 * * *
# Abuse-protection limits (all optional, shown with their defaults).
APP_MCP_CALLS_PER_MINUTE=60
APP_MCP_IMAGE_CALLS_PER_DAY=200
APP_MCP_AUTHORIZATION_REQUESTS_PER_MINUTE=30
APP_MCP_FAILED_TOKEN_LOOKUPS_PER_MINUTE=30