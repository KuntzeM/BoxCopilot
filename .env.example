# Database Configuration
POSTGRES_USER=boxuser
POSTGRES_PASSWORD=boxpass
POSTGRES_DB=boxcopilot

# Redis Configuration
# docker-compose pins REDIS_HOST=redis and REDIS_PORT=6379 for the backend container; these only matter outside compose.
REDIS_PORT=6379
# Required: password for Redis (requirepass) and the backend session store. Generate e.g. with: openssl rand -base64 24
REDIS_PASSWORD=

# Backend Configuration
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# OAuth2/OIDC Configuration (Nextcloud)
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
NEXTCLOUD_URL=https://example.nextcloud.com
NEXTCLOUD_LOGOUT_URL=https://example.nextcloud.com/index.php/logout

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
# Base URL the SPA calls the backend on (baked into the frontend bundle at build time).
# MUST name the same origin as BACKEND_URL below: the backend sets the mcp_authz cookie and the MCP OAuth
# issuer on BACKEND_URL, while the SPA builds the MCP "continue" URL and the connector URL from this value.
# If the two differ, the Claude connect flow would loop; with APP_MCP_ENABLED=true the backend refuses to start.
VITE_API_BASE_URL=http://localhost:8080
# The frontend container derives the origin allowed in its Content-Security-Policy (API_ORIGIN) from
# VITE_API_BASE_URL; docker-compose.yml does that, there is nothing to set. Keep VITE_API_BASE_URL a bare origin
# (scheme://host[:port], no path).
# Content-Security-Policy of the frontend: "report" (default) only reports violations in the browser console,
# "enforce" blocks them. Check the console on a real session first, then switch.
CSP_MODE=report
# Strict-Transport-Security from the frontend nginx. On by default in docker-compose.yml (production runs behind
# Traefik TLS); set to false only for plain-http setups.
HSTS_ENABLED=true

# Maximum number of image uploads decoded at the same time (default 2). Further uploads wait briefly, then get
# 503 with Retry-After. Uploads are limited to 25 megapixels. Optional.
APP_IMAGE_MAX_CONCURRENT_UPLOADS=2

# Image Storage Path
# Development: ./data/images (relative path)
# Production: /var/boxcopilot/images (absolute path)
# Windows: C:/boxcopilot/images (use forward slashes)
APP_IMAGE_STORAGE_PATH=/var/boxcopilot/images

# Admin User Configuration
ADMIN_USERNAME=admin
# Required in production: no default; startup fails if empty, "admin" or shorter than 12 characters.
# Generate e.g. with: openssl rand -base64 24
ADMIN_PASSWORD=
ADMIN_NAME=Administrator

# Magic Login Link Configuration
MAGIC_LINK_VALID_HOURS=24

# Traefik Hostnames
TRAEFIK_FRONTEND_HOST=box.localhost
TRAEFIK_BACKEND_HOST=box-backend.localhost

# Failed-login throttling per client IP (optional, shown with the defaults; counted in this process, reset on restart).
# 429 + Retry-After once an IP has this many failures in the window; a single IP+username pair has its own limit.
# Needs a correct TRUSTED_PROXY_PATTERN below, otherwise all clients share one counter.
APP_LOGIN_THROTTLE_IP_LIMIT=10
APP_LOGIN_THROTTLE_IP_USER_LIMIT=5
APP_LOGIN_THROTTLE_WINDOW=15m

# SameSite attribute of the session cookie (default none, which a SPA on another site needs).
# Set it to lax when frontend and backend share a site (e.g. app.example.com and api.example.com).
# Do not use strict: it breaks the OIDC redirect back to the backend.
SESSION_COOKIE_SAME_SITE=none

# Trusted reverse proxy addresses (Java regular expression, NOT CIDR notation).
# Tomcat's RemoteIpValve matches the immediate peer address against this pattern before trusting its
# X-Forwarded-* headers. Needed for correct client IPs in login throttling, MCP rate limiting and the MCP audit log.
# If it does not match the real proxy, every client looks like the proxy and shares one throttle counter.
# Default (see application-prod.yml) covers RFC1918 private ranges plus loopback; narrow it to the
# actual Traefik/proxy address space in production.
# Leave the line commented out to use the default.
# TRUSTED_PROXY_PATTERN=

# Claude / MCP integration (see docs/ops/mcp-server.md for the operations guide)
# Master kill-switch; false = feature fully disabled, no MCP endpoints reachable.
APP_MCP_ENABLED=false
# Public base URL of this backend (OAuth issuer / resource identifier). Required when APP_MCP_ENABLED=true;
# must be https in production.
# MUST name the same origin as VITE_API_BASE_URL above — the cookie is set here, the redirect back into the
# flow is built from VITE_API_BASE_URL, so a divergence makes the Claude connect flow loop without an error.
BACKEND_URL=http://localhost:8080
# Cron schedule for the nightly cleanup of expired/invalidated MCP authorizations.
APP_MCP_CLEANUP_CRON=0 0 3 * * *
# SameSite attribute of the short-lived mcp_authz pending-authorization cookie. Blank follows the session
# cookie (server.servlet.session.cookie.same-site, "none" in prod); set it to Lax when the frontend and the
# backend share a site.
APP_MCP_COOKIE_SAME_SITE=
# Abuse-protection limits (all optional, shown with their defaults).
APP_MCP_CALLS_PER_MINUTE=60
APP_MCP_IMAGE_CALLS_PER_DAY=200
APP_MCP_AUTHORIZATION_REQUESTS_PER_MINUTE=30
APP_MCP_FAILED_TOKEN_LOOKUPS_PER_MINUTE=30