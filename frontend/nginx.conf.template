# Rendered by the nginx image's envsubst step (only API_ORIGIN, CSP_MODE, HSTS_ENABLED; see NGINX_ENVSUBST_FILTER
# in the Dockerfile), so nginx's own $variables stay untouched. This file is included in the http context.
# add_header with an empty value is skipped, so each map yields either the header value or "".
# CSP additions for lazy @react-pdf/renderer (label PDFs): 'wasm-unsafe-eval' = compile its WebAssembly (no JS eval);
# data: in connect-src = it fetches its inlined wasm from a data: URI; worker-src blob: = it spawns a blob: worker.
map "${CSP_MODE}" $csp_enforce {
    default "";
    enforce "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${API_ORIGIN}; font-src 'self' data:; connect-src 'self' data: ${API_ORIGIN}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";
}
# anything other than CSP_MODE=enforce is report-only
map "${CSP_MODE}" $csp_report {
    default "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: ${API_ORIGIN}; font-src 'self' data:; connect-src 'self' data: ${API_ORIGIN}; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'";
    enforce "";
}
# HSTS only behind TLS (HSTS_ENABLED=true)
map "${HSTS_ENABLED}" $hsts {
    default "";
    true "max-age=31536000; includeSubDomains";
}

server {
    listen 80;
    server_name _;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Basic security headers. nginx drops inherited add_header lines in any location that declares its own,
    # so every location below that adds a header includes this file again.
    include /etc/nginx/conf.d/security-headers.inc;

    location / {
        try_files $uri $uri/ /index.html;
        # index.html names the hashed bundles, so it must be revalidated on every visit
        add_header Cache-Control "no-cache";
        include /etc/nginx/conf.d/security-headers.inc;
    }

    location /assets/ {
        try_files $uri =404;
        access_log off;
        # file names carry a content hash
        add_header Cache-Control "public, max-age=31536000, immutable";
        include /etc/nginx/conf.d/security-headers.inc;
    }

    # Proxy API calls to backend service (docker-compose service name: backend)
    location /api/ {
        proxy_pass http://backend:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
