# Rendered to conf.d/security-headers.inc (not *.conf, so "include conf.d/*.conf" never loads it as a server config).
add_header X-Content-Type-Options nosniff always;
add_header X-Frame-Options DENY always;
add_header Referrer-Policy "no-referrer" always;
add_header Content-Security-Policy $csp_enforce always;
add_header Content-Security-Policy-Report-Only $csp_report always;
add_header Strict-Transport-Security $hsts always;
